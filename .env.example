# ============================================================
# NetShield AI — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
HOST=0.0.0.0
PYTHON_PORT=8000
NODE_PORT=3001

# --- Database ---
DB_PATH=python-engine/netshield.db

# --- ML Model Paths (leave empty to use v3 defaults) ---
# Defaults: python-engine/models/v3/intrusion_model_v3.pkl etc.
MODEL_PATH=
PREPROCESSOR_PATH=
ENCODER_PATH=
METADATA_PATH=

# --- Live Packet Capture ---
CAPTURE_ENABLED=true
# Interface name (e.g. "Wi-Fi", "Ethernet"). Leave empty for Scapy default.
CAPTURE_INTERFACE=Wi-Fi
# Optional BPF filter (e.g. "tcp port 80")
CAPTURE_BPF_FILTER=
# Idle flow timeout in seconds
IDLE_TIMEOUT_S=120

# Prediction Filtering
# Minimum confidence (0-1) for attack classification. Below this, downgraded to BENIGN.
ATTACK_CONFIDENCE_THRESHOLD=0.80

# --- Gemini API (for AI Chatbot) ---
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram Bot (for alerts) ---
# Create bot via @BotFather on Telegram, get token
# Then send a message to the bot and get chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email Alerts (Gmail SMTP) ---
# Enable 2FA, generate App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# --- Alert Behaviour ---
ALERT_COOLDOWN_S=30
VOICE_ALERTS=true

# --- Reports ---
REPORT_DIR=reports
